PASSKIT_PASSPHRASE=your_passphrase
PASSKIT_ADDRESS=grpc.pub1.passkit.io
PASSKIT_PORT=443
PASSKIT_ROOT_CERT=./certs/ca-chain.pem
PASSKIT_PRIVATE_KEY=./certs/key.pem
PASSKIT_CERTIFICATE=./certs/certificate.pem
# Optional: email generated passes to this recipient.
# PASSKIT_RECIPIENT_EMAIL=developer@example.com
# Required only for flights.
# PASSKIT_APPLE_CERTIFICATE=pass.com.yourcertificate
# Set to true to inspect generated resources after an example completes.
PASSKIT_KEEP_ASSETS=false
